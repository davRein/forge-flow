{
  "name": "dev-suite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["frontend"],
  "scripts": {
    "setup:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-local.ps1",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "backup:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-local.ps1",
    "restore:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restore-local.ps1",
    "test:local-scripts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-local-scripts.ps1",
    "test:postgres": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-postgres-local.ps1",
    "dev": "npm run dev --workspace frontend --",
    "build": "npm run build --workspace frontend --",
    "lint": "npm run lint --workspace frontend --",
    "test": "npm run test --workspace frontend --",
    "preview": "npm run preview --workspace frontend --"
  }
}
