{
  "openapi": "3.1.0",
  "info": {
    "title": "ForgeFlow API",
    "version": "1.0.0",
    "description": "Spring-Boot-Vertrag. Workspace-Änderungen sind atomare Transaktionen je Benutzerkonto. Optionaler PostgreSQL-Speicher mit JPA/Flyway; Standardprofil memory bleibt ohne Datenbank nutzbar. Kontoverwaltung mit stabilen Benutzerkennungen, Sitzungswiderruf und geschütztem Administratorkonto."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Dienst verfügbar.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "storage": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "storage"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Fehler mit stabilem Code, insbesondere 400, 401, 403, 409, 413, 422, 428, 429 und 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/csrf": {
      "get": {
        "operationId": "getCsrf",
        "security": [],
        "responses": {
          "200": {
            "description": "Erstellt bei Bedarf eine anonyme Sitzung und liefert den CSRF-Token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Csrf"
                }
              }
            }
          },
          "default": {
            "description": "Fehler mit stabilem Code, insbesondere 400, 401, 403, 409, 413, 422, 428, 429 und 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "security": [
          {
            "csrfHeader": []
          }
        ],
        "description": "Origin muss APP_ORIGIN entsprechen. CSRF und anonyme Sitzung zuerst über /auth/csrf beziehen. BCrypt-Prüfung serverseitig; Sitzungs-ID und CSRF werden erneuert.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Anmeldung erfolgreich; HttpOnly-Cookie setzt die Sitzung.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Fehler mit stabilem Code, insbesondere 400, 401, 403, 409, 413, 422, 428, 429 und 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/session": {
      "get": {
        "operationId": "getSession",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Verifiziertes Konto und aktueller CSRF-Token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Fehler mit stabilem Code, insbesondere 400, 401, 403, 409, 413, 422, 428, 429 und 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ],
        "responses": {
          "204": {
            "description": "Sitzung serverseitig beendet und Cookie gelöscht."
          },
          "default": {
            "description": "Fehler mit stabilem Code, insbesondere 400, 401, 403, 409, 413, 422, 428, 429 und 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/me/settings": {
      "get": {
        "operationId": "getSettings",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Einstellungen des angemeldeten Kontos oder JSON null.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Settings"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Fehler mit stabilem Code, insbesondere 400, 401, 403, 409, 413, 422, 428, 429 und 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "saveSettings",
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Settings"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Einstellungen gespeichert."
          },
          "default": {
            "description": "Fehler mit stabilem Code, insbesondere 400, 401, 403, 409, 413, 422, 428, 429 und 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/workspace": {
      "get": {
        "operationId": "loadWorkspace",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Vollständiger Workspace des Kontos; bei neuem Konto leere Listen.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            },
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Aktuelle Revision in doppelten Anführungszeichen."
              }
            }
          },
          "default": {
            "description": "Fehler mit stabilem Code, insbesondere 400, 401, 403, 409, 413, 422, 428, 429 und 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "saveWorkspace",
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ],
        "description": "Atomar alle Fachdaten und neue Dateiinhalte übernehmen. Maximal 20 MiB Dateiinhalte je Konto, 25 MiB Anfrage. Fehler verändern keine Daten. Nicht übermittelte vorhandene Dateien werden entfernt, sofern sie im Manifest fehlen.",
        "parameters": [
          {
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exakt die zuletzt bestätigte Revision, einschließlich doppelter Anführungszeichen."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "manifest"
                ],
                "properties": {
                  "manifest": {
                    "type": "string",
                    "contentMediaType": "application/json",
                    "contentSchema": {
                      "$ref": "#/components/schemas/Workspace"
                    }
                  }
                },
                "patternProperties": {
                  "^file-[1-9][0-9]*$": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Neue Revision nach erfolgreicher Transaktion.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "revision": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "revision"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Fehler mit stabilem Code, insbesondere 400, 401, 403, 409, 413, 422, 428, 429 und 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/files/{fileId}/content": {
      "get": {
        "operationId": "downloadFile",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          {
            "in": "path",
            "name": "fileId",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Binärinhalt; Zugriff nur im Workspace des angemeldeten Kontos.",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "description": "Fehler mit stabilem Code, insbesondere 400, 401, 403, 409, 413, 422, 428, 429 und 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/me/profile": {
      "put": {
        "operationId": "updateMyProfile",
        "description": "Profil des eigenen Kontos ändern. Eine neue E-Mail-Adresse verlangt das aktuelle Passwort und beendet andere Sitzungen. Bei E-Mail-Änderung wird die aktuelle Sitzung samt CSRF erneuert; reine Namensänderungen erhalten die Sitzung.",
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profil und erneuerte Sitzung.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Strukturierter Fehler, insbesondere 400, 401, 403, 404, 409, 429 und 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/me/password": {
      "post": {
        "operationId": "changeMyPassword",
        "description": "Aktuelles Passwort prüfen, neues Passwort mit BCrypt speichern und alle bisherigen Sitzungen ungültig machen. Anschließend erneut anmelden.",
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordChange"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Passwort geändert; Sitzung beendet."
          },
          "default": {
            "description": "Strukturierter Fehler, insbesondere 400, 401, 403, 404, 409, 429 und 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "operationId": "listUsers",
        "description": "Nur Administratoren: Konten ohne Passwort-Hashes oder Sitzungsinformationen auflisten.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Kontoliste.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Strukturierter Fehler, insbesondere 400, 401, 403, 404, 409, 429 und 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createUser",
        "description": "Nur Administratoren: eigenes leeres Benutzerkonto ohne Administratorrechte anlegen. Keine öffentliche Registrierung.",
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewUser"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Konto angelegt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "description": "Strukturierter Fehler, insbesondere 400, 401, 403, 404, 409, 429 und 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}/active": {
      "put": {
        "operationId": "setUserActive",
        "description": "Nur Administratoren: normales Konto aktivieren oder deaktivieren. Deaktivierung erhält die Daten und widerruft Sitzungen. Das Administratorkonto ist geschützt.",
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountActive"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Aktueller Kontostatus.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "description": "Strukturierter Fehler, insbesondere 400, 401, 403, 404, 409, 429 und 503.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "FORGEFLOW_SESSION"
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-TOKEN"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "administrator": {
            "type": "boolean",
            "description": "Berechtigung zur Kontoverwaltung."
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "administrator",
          "active"
        ]
      },
      "Csrf": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "csrfToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "csrfToken"
        ]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "csrfToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "user",
          "csrfToken"
        ]
      },
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "minLength": 1,
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "description": "Unverändert senden; höchstens 72 UTF-8-Bytes."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Project": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "customerId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "planningCompleted": {
            "type": "boolean"
          },
          "deadline": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "id",
          "customerId",
          "name",
          "planningCompleted",
          "deadline"
        ]
      },
      "Customer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "street": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "website": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "phone": {
            "type": "string"
          },
          "industry": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "street",
          "city",
          "country",
          "email",
          "phone",
          "industry"
        ]
      },
      "Task": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "projectId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "epicId": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "todo",
              "inProgress",
              "done"
            ]
          },
          "priority": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "createdAt": {
            "type": "string",
            "anyOf": [
              {
                "format": "date"
              },
              {
                "format": "date-time"
              }
            ]
          },
          "updatedAt": {
            "type": "string",
            "anyOf": [
              {
                "format": "date"
              },
              {
                "format": "date-time"
              }
            ]
          }
        },
        "required": [
          "id",
          "projectId",
          "code",
          "title",
          "status",
          "priority",
          "createdAt",
          "updatedAt"
        ]
      },
      "Epic": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "projectId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "description": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "anyOf": [
              {
                "format": "date"
              },
              {
                "format": "date-time"
              }
            ]
          },
          "updatedAt": {
            "type": "string",
            "anyOf": [
              {
                "format": "date"
              },
              {
                "format": "date-time"
              }
            ]
          }
        },
        "required": [
          "id",
          "projectId",
          "title",
          "description",
          "createdAt",
          "updatedAt"
        ]
      },
      "TaskSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "status": {
            "enum": [
              "todo",
              "inProgress",
              "done"
            ]
          }
        },
        "required": [
