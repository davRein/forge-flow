# local: Beispieldaten ohne Server; api: Anmeldung und Speicherung über das Backend.
VITE_DATA_MODE=local
VITE_API_BASE_URL=/api/v1
# Optional HTTPS origin for the Cloud app. Empty disables the external link.
VITE_NEXTCLOUD_URL=https://cloud.forge-flow.de
# Embedded apps: local defaults apply only in development. Set HTTPS URLs for deployment.
# Child frontends also need their exact trusted suite origin. See docs/local-operation.md.
# Empty values disable the corresponding embedded app.
# Optional UI restriction; the server must independently enforce access via auth_request.
VITE_SHOWCASE_ADMIN_ONLY=false
# VITE_KNOWLEDGE_HUB_URL=http://localhost:3000
# VITE_FLOWPILOT_URL=http://localhost:5174
